<sigml><hamgestural_sign gloss="NEED"><sign_manual>
<handconfig handshape="finger2" thumbpos="across" bend2="0 3.34 0 0"/>
<handconfig extfidir="u"/><handconfig palmor="d"/>
<location_bodyarm location="shoulders" side="right_at" contact="neutral"/>
<rpt_motion repetition="fromstart"><tgt_motion><changeposture/>
<handconfig extfidir="o"/><handconfig palmor="d"/>
</tgt_motion></rpt_motion>
</sign_manual></hamgestural_sign><hamgestural_sign gloss="YOU"><sign_manual>
<handconfig handshape="finger2" thumbpos="across" extfidir="o" palmor="l"/>
<location_bodyarm location="chest" contact="neutral"/>
<directedmotion direction="o" size="small"/>
</sign_manual></hamgestural_sign></sigml>