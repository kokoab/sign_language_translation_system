<sigml><hamgestural_sign gloss="NEED"><sign_manual>
<handconfig handshape="finger2" thumbpos="across" mainbend="hooked"/>
<handconfig extfidir="u"/><handconfig palmor="d"/>
<location_bodyarm location="chest" contact="neutral"/>
<rpt_motion repetition="fromstart"><tgt_motion><changeposture/>
<handconfig extfidir="o"/><handconfig palmor="d"/>
</tgt_motion></rpt_motion>
</sign_manual></hamgestural_sign></sigml>