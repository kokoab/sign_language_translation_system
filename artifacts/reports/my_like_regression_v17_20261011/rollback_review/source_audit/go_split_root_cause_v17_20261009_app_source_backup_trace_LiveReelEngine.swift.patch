+    private var traceRows: [[String: Any]]?
+    private let traceLock = NSLock()
+    func startTrace() { traceLock.lock(); traceRows = traceRows ?? []; traceRows!.append(["start": true]); traceLock.unlock() }
+    func takeTrace() -> [[String: Any]]? { traceLock.lock(); defer { traceLock.unlock() }; return traceRows }
+    private func traceFrame(_ o: LiveObservation, _ hand: LiveHandFrame?, held: Bool) {
+        traceLock.lock(); defer { traceLock.unlock() }
+        guard traceRows != nil else { return }
+        func pts(_ p: [LivePoint]) -> [[Float]] { p.map { [$0.x, $0.y, $0.c] } }
+        var row: [String: Any] = ["s": o.seconds, "w": o.width, "h": o.height, "b": pts(o.body), "f": pts(o.face),
+                                  "ff": o.faceForFeatures, "held": held]
+        if let l = o.left { row["l"] = pts(l.points); row["lc"] = l.chirality; row["ls"] = l.score }
+        if let r = o.right { row["r"] = pts(r.points); row["rc"] = r.chirality; row["rs"] = r.score }
+        if let hand {
+            let half = hand.embeddings.map { Float16($0) }
+            row["e"] = half.withUnsafeBufferPointer { Data(buffer: $0) }.base64EncodedString()
+            row["v"] = hand.valid; row["x"] = hand.boxes
+        }
+        traceRows!.append(row)
+    }
