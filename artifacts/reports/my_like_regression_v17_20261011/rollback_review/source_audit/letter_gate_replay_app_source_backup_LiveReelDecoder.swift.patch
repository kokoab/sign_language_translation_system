+        let changed = (1..<core.count).contains { t in
+            (0..<42).contains { j in abs(core[t][j*5]-core[t-1][j*5]) >= 1e-6 || abs(core[t][j*5+1]-core[t-1][j*5+1]) >= 1e-6 }
