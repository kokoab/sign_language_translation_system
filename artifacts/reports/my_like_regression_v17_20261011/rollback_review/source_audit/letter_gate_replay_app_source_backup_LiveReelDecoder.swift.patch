+            let before = raw[...start].filter { $0[st*5+4]>=0.3 && $0[(st+9)*5+4]>=0.3 }
+            let after = core.filter { $0[st*5+4]>=0.3 && $0[(st+9)*5+4]>=0.3 }
+            guard before.count>=2, after.count>=2 else { continue }
