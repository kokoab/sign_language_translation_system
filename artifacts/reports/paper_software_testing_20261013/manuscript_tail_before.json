[{"startIndex":136449,"endIndex":136506,"paragraph":{"elements":[{"startIndex":136449,"endIndex":136506,"textRun":{"content":"4.5.5 Functional Testing and Software Quality Evaluation\n","textStyle":{"bold":true,"foregroundColor":{"color":{"rgbColor":{}}},"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"headingId":"h.t13e2yxa5jm8","namedStyleType":"HEADING_3","alignment":"START","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":6,"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":true,"keepWithNext":true}}},{"startIndex":136506,"endIndex":136584,"paragraph":{"elements":[{"startIndex":136506,"endIndex":136584,"textRun":{"content":"Distinction Between Technical System Testing and Human Participant Evaluation\n","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","direction":"LEFT_TO_RIGHT","spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":6,"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepWithNext":true}}},{"startIndex":136584,"endIndex":136875,"paragraph":{"elements":[{"startIndex":136584,"endIndex":136875,"textRun":{"content":"The evaluation of ATLAS shall consist of two distinct components: (1) technical system evaluation and (2) human participant evaluation. These components shall be treated separately to distinguish system performance measurements from information obtained directly from research participants.\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":true,"keepWithNext":false}}},{"startIndex":136875,"endIndex":137482,"paragraph":{"elements":[{"startIndex":136875,"endIndex":137482,"textRun":{"content":"Technical system evaluation refers to the assessment of the technical and functional performance of the developed system. This evaluation does not require human participants and shall be conducted using prepared datasets, sign-sequence data, gloss-to-English pairs, trained and exported models, controlled system inputs, and other development or testing resources. Technical evaluation shall include appropriate measures of system performance, such as Top-1 accuracy, Top-5 accuracy, Word Error Rate (WER), English-output performance, processing time, and model size, as applicable to the developed system.\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":true,"keepWithNext":false}}},{"startIndex":137482,"endIndex":137840,"paragraph":{"elements":[{"startIndex":137482,"endIndex":137840,"textRun":{"content":"Human participant evaluation, on the other hand, refers to information obtained directly from eligible research participants during the evaluation of the system. Participant-provided information may include their responses to the evaluation procedures, observations, comments, suggestions, and other feedback collected through the approved research process.\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":true,"keepWithNext":false}}},{"startIndex":137840,"endIndex":138194,"paragraph":{"elements":[{"startIndex":137840,"endIndex":138194,"textRun":{"content":"The technical performance results generated from datasets and system testing shall not be treated as participant data. Conversely, information directly provided by research participants shall be treated as research data and shall be handled in accordance with the informed consent process, data protection safeguards, and the approved research protocol.\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":true,"keepWithNext":false}}},{"startIndex":138194,"endIndex":138195,"paragraph":{"elements":[{"startIndex":138194,"endIndex":138195,"textRun":{"content":"\n","textStyle":{"fontSize":{"magnitude":2,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"START","lineSpacing":100,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":true,"keepWithNext":false}}},{"startIndex":138195,"endIndex":138608,"paragraph":{"elements":[{"startIndex":138195,"endIndex":138608,"textRun":{"content":"The technical measurements in the preceding subsections establish recognition, English-generation and device-processing results under their stated conditions. They do not constitute completed participant-based software-quality findings. Functional-test outcomes and participant-evaluation findings will be reported against the requirements and approved instruments when their corresponding records are available.\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"indentFirstLine":{"magnitude":36,"unit":"PT"},"indentStart":{"unit":"PT"},"indentEnd":{"unit":"PT"},"keepLinesTogether":true,"keepWithNext":false}}},{"startIndex":138608,"endIndex":138619,"paragraph":{"elements":[{"startIndex":138608,"endIndex":138619,"textRun":{"content":"REFERENCES\n","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"headingId":"h.i4s24jpy9y6m","namedStyleType":"HEADING_1","alignment":"CENTER","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceBelow":{"magnitude":6,"unit":"PT"},"indentStart":{"magnitude":36,"unit":"PT"}}}},{"startIndex":138619,"endIndex":138909,"paragraph":{"elements":[{"startIndex":138619,"endIndex":138909,"textRun":{"content":"Amiruzzaman, S., Batchu, R. M., Amiruzzaman, M., Ngo, L., & Dewan, M. A. A. (2026). ASL recognition and game-based interaction: A machine learning–driven, gamified and accessible vocabulary learning system for Deaf learners. Computers, 15(5), 299. https://doi.org/10.3390/computers15050299\n","textStyle":{"fontSize":{"magnitude":12,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":200,"direction":"LEFT_TO_RIGHT","spaceAbove":{"unit":"PT