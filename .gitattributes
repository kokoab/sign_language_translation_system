# Generated CSV reports use CRLF in several upstream/export tools. Treat CR as EOL
# for whitespace validation without rewriting evidence files during publication.
*.csv whitespace=cr-at-eol

# Markdown uses two trailing spaces intentionally for hard line breaks.
*.md whitespace=-trailing-space

# Preserve generator formatting and exact saved source snapshots during publication.
*.svg whitespace=-blank-at-eol
artifacts/reports/**/baseline/*.py whitespace=-blank-at-eof
